# Salesforce Connected App credentials (from Manage Consumer Details)
SF_CLIENT_ID=your_consumer_key_here
SF_CLIENT_SECRET=your_consumer_secret_here

# Must exactly match the Callback URL set in the Connected App
SF_CALLBACK_URL=http://localhost:5000/oauth/callback

# Use https://login.salesforce.com for a Developer Org / production
# Use https://test.salesforce.com for a sandbox
SF_LOGIN_URL=https://login.salesforce.com

# Session secret - any random long string
SESSION_SECRET=change_this_to_a_long_random_string

# URL of the deployed/running frontend, for CORS + post-login redirect
FRONTEND_URL=http://localhost:3000

PORT=5000
